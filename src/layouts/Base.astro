---
import '../styles/global.css';
import Header from '../components/Header.astro';
import RecallBar from '../components/RecallBar.astro';
import Footer from '../components/Footer.astro';
import { langFromPath, t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Doplňkové JSON-LD objekty (Article, FAQPage, BreadcrumbList…) */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Obrázek pro sdílení (cesta od kořene webu), výchozí /images/og/default.png */
  ogImage?: string;
  /**
   * false = na stránce se nikdy nesmí načíst reklama (AdSense ani jiná síť).
   * Povinně u stránek o počátečních mlécích – viz CLAUDE.md, sekce Reklama.
   * Reklamní skript se smí vykreslit jen pod podmínkou `ads`.
   */
  ads?: boolean;
  /** Jazykové verze stejné stránky (hreflang + přepínač v patičce), cesty od kořene */
  alternates?: { cs: string; sk: string };
}

const { title, description, jsonLd = [], noindex = false, ogType = 'website', ogImage: ogImageProp, ads = true, alternates } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const L = t(lang);
const ogImage = ogImageProp ?? (lang === 'sk' ? '/images/og/sk-default.png' : '/images/og/default.png');
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const siteName = L.siteName;
const fullTitle = title === siteName ? `${siteName} – ${L.siteTagline}` : `${title} | ${siteName}`;
const altUrl = alternates ? (lang === 'sk' ? alternates.cs : alternates.sk) : undefined;
const homeUrl = new URL(lang === 'sk' ? '/sk/' : '/', Astro.site).toString();
const canonical = new URL(Astro.url.pathname, Astro.site);

const baseLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: homeUrl,
    inLanguage: L.bcp47,
    publisher: { '@id': new URL('/#organizace', Astro.site).toString() },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': new URL('/#organizace', Astro.site).toString(),
    name: 'kojeneckemleko.cz',
    url: Astro.site?.toString(),
    description: lang === 'sk'
      ? 'Nezávislý sprievodca kŕmením bábätka. Bez reklamy na dojčenské mlieka a bez provízií.'
      : 'Nezávislý průvodce krmením miminka pro rodiče v ČR. Bez reklamy na kojenecká mléka a bez provizí.',
    publishingPrinciples: new URL(L.howWeWorkUrl, Astro.site).toString(),
  },
  ...jsonLd,
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && !noindex && (
      <>
        <link rel="alternate" hreflang="cs-CZ" href={new URL(alternates.cs, Astro.site)} />
        <link rel="alternate" hreflang="sk-SK" href={new URL(alternates.sk, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.cs, Astro.site)} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!ads && <meta name="km-reklama" content="ne" />}
    <meta name="theme-color" content="#fffefc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/ikona-180.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    <script is:inline>
      // Lístky v ilustracích „vyrostou“ při prvním zobrazení – jen s JS a bez prefers-reduced-motion
      try { if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('anim'); } catch (e) {}
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={L.locale} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />

    {baseLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <a class="skip-link" href="#obsah">{L.skip}</a>
    {lang === 'cs' && <RecallBar />}
    <Header />
    <main id="obsah">
      <slot />
    </main>
    <Footer altUrl={altUrl} />
    <script is:inline>
      // Posun tooltipu .term, aby se vešel do šířky okna
      (function () {
        function fit(e) {
          var el = e.target && e.target.closest ? e.target.closest('.term') : null;
          if (!el) return;
          var r = el.getBoundingClientRect(), vw = document.documentElement.clientWidth, pad = 12;
          var w = Math.min(272, vw - 32), c = r.left + r.width / 2, left = c - w / 2, dx = 0;
          if (left < pad) dx = pad - left; else if (left + w > vw - pad) dx = vw - pad - (left + w);
          el.style.setProperty('--tip-dx', Math.round(dx) + 'px');
        }
        document.addEventListener('pointerover', fit, { passive: true });
        document.addEventListener('focusin', fit);
      })();
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains('anim')) return;
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('svg.illu, svg.cover').forEach(function (el) { io.observe(el); });
      })();
    </script>
    {!noindex && (
      <script is:inline>
        // Měření návštěvnosti bez cookies – viz /ochrana-soukromi/
        (function () {
          try {
            var h = location.hostname;
            if (navigator.doNotTrack === '1' || navigator.globalPrivacyControl || h === 'localhost' || h === '127.0.0.1') return;
            // Vlastní návštěvy se nepočítají: ?nemerit=1 (nebo přihlášení na /navstevnost/) uloží značku do localStorage, ?nemerit=0 ji smaže
            var q = new URLSearchParams(location.search).get('nemerit');
            try {
              if (q === '1') localStorage.setItem('km-nemerit', '1');
              if (q === '0') localStorage.removeItem('km-nemerit');
              if (localStorage.getItem('km-nemerit') === '1') return;
            } catch (e) {}
            var send = function (url, d) {
              if (!(navigator.sendBeacon && navigator.sendBeacon(url, d))) {
                fetch(url, { method: 'POST', body: d, keepalive: true }).catch(function () {});
              }
            };
            send('/api/hit.php', JSON.stringify({ p: location.pathname, r: document.referrer }));

            // Cíle: anonymní počty akcí (bez cookies a identifikátorů), každá nejvýš jednou na zobrazení stránky.
            // Seznam povolených názvů je v public/api/_lib.php (km_events).
            var sent = {};
            window.kmEvent = function (name) {
              if (sent[name]) return;
              sent[name] = 1;
              send('/api/event.php', JSON.stringify({ e: name, p: location.pathname }));
            };
            var ev = window.kmEvent;
            var tools = '[data-recall-check],[data-growth],[data-useby],[data-allergens],[data-feeding-log],.calc';
            var onUse = function (e) {
              var t = e.target;
              if (!t || !t.closest) return;
              if (t.closest(tools) && (e.type !== 'click' || t.closest('button,label,summary'))) ev('nastroj');
              if (t.closest('.table-panel') && (e.type !== 'click' || t.closest('button,label,th,select'))) ev('srovnani');
              if (e.type !== 'click') return;
              var a = t.closest('a[href]');
              if (t.closest('[data-print]')) ev('tisk');
              if (t.closest('.faq summary')) ev('faq');
              if (!a) return;
              if (/\.pdf($|\?)/.test(a.getAttribute('href'))) ev('pdf');
              else if (a.hostname && a.hostname !== h && a.closest('#zdroje, .prose, article')) ev('zdroj');
              else if (a.closest('.related')) ev('dalsi');
            };
            document.addEventListener('click', onUse, true);
            document.addEventListener('change', onUse, true);
            var src = document.getElementById('zdroje');
            if (src && 'IntersectionObserver' in window) {
              var t0 = Date.now();
              var io = new IntersectionObserver(function (es) {
                if (!es[0].isIntersecting) return;
                io.disconnect();
                setTimeout(function () { ev('cteni'); }, Math.max(0, 20000 - (Date.now() - t0)));
              });
              io.observe(src);
            }
          } catch (e) {}
        })();
      </script>
    )}
  </body>
</html>
