---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Doplňkové JSON-LD objekty (Article, FAQPage, BreadcrumbList…) */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, jsonLd = [], noindex = false, ogType = 'website' } = Astro.props;
const siteName = 'Kojenecké mléko';
const fullTitle = title === siteName ? `${siteName} – průvodce krmením miminka` : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const baseLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: Astro.site?.toString(),
    inLanguage: 'cs-CZ',
  },
  ...jsonLd,
];
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fffefc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    {baseLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
    <Header />
    <main id="obsah">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Posun tooltipu .term, aby se vešel do šířky okna
      (function () {
        function fit(e) {
          var el = e.target && e.target.closest ? e.target.closest('.term') : null;
          if (!el) return;
          var r = el.getBoundingClientRect(), vw = document.documentElement.clientWidth, pad = 12;
          var w = Math.min(272, vw - 32), c = r.left + r.width / 2, left = c - w / 2, dx = 0;
          if (left < pad) dx = pad - left; else if (left + w > vw - pad) dx = vw - pad - (left + w);
          el.style.setProperty('--tip-dx', Math.round(dx) + 'px');
        }
        document.addEventListener('pointerover', fit, { passive: true });
        document.addEventListener('focusin', fit);
      })();
    </script>
    {!noindex && (
      <script is:inline>
        // Měření návštěvnosti bez cookies – viz /ochrana-soukromi/
        (function () {
          try {
            var h = location.hostname;
            if (navigator.doNotTrack === '1' || navigator.globalPrivacyControl || h === 'localhost' || h === '127.0.0.1') return;
            var d = JSON.stringify({ p: location.pathname, r: document.referrer });
            if (!(navigator.sendBeacon && navigator.sendBeacon('/api/hit.php', d))) {
              fetch('/api/hit.php', { method: 'POST', body: d, keepalive: true }).catch(function () {});
            }
          } catch (e) {}
        })();
      </script>
    )}
  </body>
</html>
