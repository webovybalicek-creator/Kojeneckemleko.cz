---
const nav = [
  { href: '/mleka/', label: 'Kojenecká mléka' },
  { href: '/krmeni/', label: 'Krmení' },
  { href: '/prikrmy/', label: 'Příkrmy' },
  { href: '/jak-tvorime-obsah/', label: 'Jak tvoříme obsah' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="logo" aria-label="kojeneckemleko.cz – úvod">
      <span class="logo__name">kojeneckemleko</span><span class="logo__tld">.cz</span>
    </a>

    <nav class="nav" aria-label="Hlavní navigace">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="/mleka/srovnani/" class="btn header-cta">Srovnání mlék</a>

    <details class="mobile-nav">
      <summary aria-label="Menu">
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </summary>
      <div class="mobile-nav__panel">
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/mleka/srovnani/" class="btn">Srovnání mlék</a></li>
        </ul>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--color-cream-paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex; align-items: center; gap: var(--space-4);
    min-height: 4.25rem;
  }
  .logo {
    display: inline-flex; align-items: baseline;
    margin-right: auto;
    font-family: var(--font-sans); font-weight: 600;
    font-size: 1.1875rem; line-height: 1; letter-spacing: -0.03em;
    color: var(--ink); text-decoration: none;
  }
  .logo__tld {
    color: var(--text-muted); font-weight: 400;
    letter-spacing: 0;
    margin-left: 0.04em;
    transition: color var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .logo:hover .logo__tld { color: var(--ink); }
  }

  .nav ul { display: flex; gap: var(--space-1); list-style: none; padding: 0; }
  .nav a {
    display: block; padding: 0.5rem 0.75rem; border-radius: var(--radius-nav);
    color: var(--color-charcoal); font-size: var(--fs-small); text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .nav a[aria-current='page'] { background: var(--color-keylime-wash); color: var(--ink); }
  @media (hover: hover) and (pointer: fine) {
    .nav a:hover { background: var(--color-keylime-wash); }
  }

  .mobile-nav { display: none; }

  @media (max-width: 960px) {
    .nav, .header-cta { display: none; }
    .mobile-nav { display: block; }
    .mobile-nav summary {
      list-style: none; display: grid; place-items: center;
      width: 2.75rem; height: 2.75rem; border-radius: var(--radius-card);
      background: var(--color-keylime-wash); cursor: pointer;
    }
    .mobile-nav summary::-webkit-details-marker { display: none; }
    .burger { display: grid; gap: 5px; width: 18px; }
    .burger span {
      display: block; height: 1.5px; background: var(--ink); border-radius: 2px;
      transition: transform var(--dur-base) var(--ease-out);
    }
    .mobile-nav[open] .burger span:first-child { transform: translateY(3.25px) rotate(45deg); }
    .mobile-nav[open] .burger span:last-child { transform: translateY(-3.25px) rotate(-45deg); }

    .mobile-nav__panel {
      position: absolute; left: 0; right: 0; top: 100%;
      background: var(--color-cream-paper);
      border-bottom: 1px solid var(--line);
      padding: var(--space-3) var(--gutter) var(--space-4);
      transform-origin: top center;
      animation: drop var(--dur-base) var(--ease-out);
    }
    .mobile-nav__panel ul { list-style: none; padding: 0; display: grid; gap: var(--space-1); }
    .mobile-nav__panel a:not(.btn) {
      display: block; padding: 0.75rem 0; font-size: 1.125rem;
      color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line);
    }
    .mobile-nav__panel .btn { margin-top: var(--space-2); }
  }

  @keyframes drop {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
