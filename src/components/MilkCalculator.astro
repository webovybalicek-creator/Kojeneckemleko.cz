---
// Orientační výpočet denního množství pro kojence do 6 měsíců:
// NHS: 150–200 ml/kg/den; AAP: nejvýše cca 960 ml/den.
import { langFromPath } from '../i18n/ui';
const sk = langFromPath(Astro.url.pathname) === 'sk';
const T = sk
  ? { eyebrow: 'Orientačný výpočet · 0–6 mesiacov', label: 'Hmotnosť bábätka', ph: 'napr. 4,5', hint: 'Výpočet podľa NHS: 150–200 ml na kilogram za deň.', start: 'Zadajte hmotnosť v kilogramoch.',
      range: 'Zadajte hmotnosť medzi 2 a 10 kg.', day: 'ml za deň', max: 'Americká pediatrická akadémia uvádza ako obvyklé maximum asi 960 ml denne. Ak bábätko dlhodobo chce viac, poraďte sa s pediatrom.',
      avg: 'Ide o priemer. Bábätko môže jeden deň piť viac a iný deň menej – riaďte sa jeho signálmi.', locale: 'sk-SK' }
  : { eyebrow: 'Orientační výpočet · 0–6 měsíců', label: 'Hmotnost miminka', ph: 'např. 4,5', hint: 'Výpočet podle NHS: 150–200 ml na kilogram za den.', start: 'Zadejte hmotnost v kilogramech.',
      range: 'Zadejte hmotnost mezi 2 a 10 kg.', day: 'ml za den', max: 'Americká pediatrická akademie uvádí jako obvyklé maximum asi 960 ml denně. Pokud miminko dlouhodobě chce víc, poraďte se s pediatrem.',
      avg: 'Jde o průměr. Miminko může jeden den pít víc a jiný den méně – řiďte se jeho signály.', locale: 'cs-CZ' };
---
<div class="calc panel panel--slate" data-t={JSON.stringify(T)}>
  <div class="calc__inner panel panel--cream">
    <p class="eyebrow">{T.eyebrow}</p>
    <label for="calc-weight" class="calc__label">{T.label}</label>
    <div class="calc__input">
      <input id="calc-weight" type="number" inputmode="decimal" min="2" max="10" step="0.1" placeholder={T.ph} aria-describedby="calc-hint" />
      <span>kg</span>
    </div>
    <p id="calc-hint" class="muted small">{T.hint}</p>
    <output for="calc-weight" class="calc__out" aria-live="polite">
      <span class="calc__value tabular" data-value>–</span>
      <span class="muted small" data-note>{T.start}</span>
    </output>
  </div>
</div>

<script>
  const input = document.querySelector<HTMLInputElement>('#calc-weight');
  const value = document.querySelector<HTMLElement>('[data-value]');
  const note = document.querySelector<HTMLElement>('[data-note]');
  const T = JSON.parse(document.querySelector<HTMLElement>('.calc')?.dataset.t ?? '{}');
  const fmt = new Intl.NumberFormat(T.locale);
  const round10 = (n: number) => Math.round(n / 10) * 10;

  input?.addEventListener('input', () => {
    const kg = parseFloat(input.value.replace(',', '.'));
    if (!value || !note) return;
    if (!kg || kg < 2 || kg > 10) {
      value.textContent = '–';
      note.textContent = T.range;
      return;
    }
    const lo = round10(kg * 150);
    const hi = round10(kg * 200);
    value.textContent = `${fmt.format(lo)}–${fmt.format(hi)} ${T.day}`;
    note.textContent = hi > 960
      ? T.max
      : T.avg;
  });
</script>

<style>
  .calc { padding: var(--space-3); margin-block: var(--space-4); }
  .calc__inner { display: grid; gap: var(--space-2); }
  .calc__label { font-weight: 600; font-size: var(--fs-h3); color: var(--ink); }
  .calc__input { display: flex; align-items: center; gap: var(--space-2); }
  .calc__input input {
    width: 9rem; padding: 0.75rem 1rem; font-size: 1.125rem;
    border: 1px solid var(--color-sage-mist); border-radius: var(--radius-card);
    background: var(--color-cream-paper);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .calc__input input:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-color: var(--ink); }
  .calc__out { display: grid; gap: 4px; padding-top: var(--space-2); border-top: 1px solid var(--line); }
  .calc__value { font-family: var(--font-serif); font-weight: 300; font-size: var(--fs-h2); color: var(--ink); line-height: 1.2; }
  .small { font-size: var(--fs-small); }
</style>
