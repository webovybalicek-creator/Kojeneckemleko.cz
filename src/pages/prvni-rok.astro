---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { obdobi, type Fakt } from '../data/prvni-rok';

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Úvod', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'První rok krmení', item: new URL('/prvni-rok/', Astro.site).toString() },
  ],
};
const rows = (o: (typeof obdobi)[number]): { k: string; f: Fakt }[] => [
  { k: 'Mléko', f: o.mleko },
  { k: o.kolikLabel ?? 'Množství', f: o.kolik },
  { k: 'Jídlo', f: o.jidlo },
];
---
<Base
  title="První rok krmení miminka měsíc po měsíci"
  description="Časová osa krmení miminka od narození do 1 roku: jaké mléko, kolik, kdy příkrmy, alergeny, vitamin D a kravské mléko. Podle WHO, NHS, ESPGHAN, EFSA a AAP."
  jsonLd={[breadcrumbs]}
>
  <section class="container">
    <header class="hub-head panel panel--mint">
      <nav class="crumbs" aria-label="Drobečková navigace"><a href="/">Úvod</a> <span aria-hidden="true">/</span> <span>První rok krmení</span></nav>
      <h1>První rok krmení</h1>
      <p class="lead">Co se v krmení mění od narození do prvních narozenin – v kostce a s odkazem na zdroj u každé věty.</p>
      <p class="note">Světová zdravotnická organizace doporučuje prvních 6 měsíců výhradně kojit a v kojení pokračovat i po zavedení příkrmů. Údaje o množství se týkají umělého mléka a jsou orientační – každé miminko je jiné.</p>
    </header>
  </section>

  <section class="container section" aria-label="Období">
    <ol class="tl">
      {obdobi.map((o, i) => (
        <li id={o.id} class="tl__item" style={`--i:${i}`}>
          <span class="tl__dot" style={`background: var(--tone-${o.tone})`} aria-hidden="true"></span>
          <div class="tl__body">
            <p class="eyebrow">{o.stitek}</p>
            <h2 class="serif">{o.nazev}</h2>
            <dl class="tl__rows">
              {rows(o).map((r) => (
                <div class="tl__row">
                  <dt class="eyebrow">{r.k}</dt>
                  <dd>{r.f.text} <span class="src">{r.f.zdroje.map((z, j) => <>{j > 0 && ', '}<a href={z.href} rel="noopener">{z.label}</a></>)}</span></dd>
                </div>
              ))}
            </dl>
            {o.dalsi.length > 0 && (
              <ul class="tl__more">
                {o.dalsi.map((d) => (
                  <li>{d.text} <span class="src">{d.zdroje.map((z, j) => <>{j > 0 && ', '}<a href={z.href} rel="noopener">{z.label}</a></>)}</span></li>
                ))}
              </ul>
            )}
            <ul class="tl__links">
              {o.odkazy.map((l) => <li><a href={l.href}>{l.label} <Arrow /></a></li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
    <p class="disclaimer muted">
      Přehled má informativní charakter a nenahrazuje konzultaci s pediatrem. Podrobnosti a všechny zdroje najdete v odkazovaných článcích.
      Situace rodičů jsou různé – podívejte se také na <a href="/zacnete-tady/">rozcestník podle situace</a>.
    </p>
  </section>
</Base>

<style>
  .hub-head { display: grid; gap: var(--space-3); justify-items: start; margin-top: var(--space-4); padding-block: var(--space-6); }
  .hub-head h1 { font-size: var(--fs-display); line-height: 1.05; }
  .hub-head > * { max-width: 44rem; }
  .crumbs { font-size: var(--fs-small); color: var(--text-muted); }
  .crumbs a { color: var(--text-muted); }
  .note { font-size: var(--fs-small); color: var(--color-charcoal); border-left: 2px solid var(--color-forest-ink); padding-left: var(--space-2); }

  .tl {
    --tone-cream: var(--color-cream-paper); --tone-keylime: var(--color-keylime-wash); --tone-mint: var(--color-mint-veil);
    --tone-sage: var(--color-sage-mist); --tone-slate: var(--color-slate-hush);
  }
  .tl { list-style: none; padding: 0; margin: 0; position: relative; max-width: 52rem; }
  .tl::before { content: ''; position: absolute; left: 0.75rem; top: 0.75rem; bottom: 0.75rem; width: 1.5px; background: var(--color-forest-ink); opacity: 0.3; }
  .tl__item { position: relative; display: grid; grid-template-columns: 1.5rem 1fr; gap: var(--space-3); padding-bottom: var(--space-6); scroll-margin-top: 6rem; }
  .tl__item:last-child { padding-bottom: 0; }
  .tl__dot { position: relative; z-index: 1; width: 1.5rem; height: 1.5rem; border-radius: 50%; border: 1.5px solid var(--color-forest-ink); margin-top: 0.1rem; }
  .tl__body h2 { font-size: var(--fs-h2); line-height: 1.1; margin: 0.25rem 0 var(--space-3); }
  .tl__rows { margin: 0; display: grid; gap: var(--space-2); }
  .tl__row { display: grid; grid-template-columns: 7rem 1fr; gap: var(--space-2); padding-top: var(--space-2); border-top: 1px solid var(--line); }
  .tl__row dt { color: var(--text-muted); margin: 0; padding-top: 0.2rem; }
  .tl__row dd { margin: 0; }
  .src { font-size: var(--fs-caption); color: var(--text-muted); }
  .src a { color: inherit; }
  .tl__more { margin: var(--space-3) 0 0; padding: var(--space-3) var(--space-3) var(--space-3) 2.25rem; background: var(--color-keylime-wash); border-radius: var(--radius-card); display: grid; gap: 0.4rem; font-size: var(--fs-small); }
  .tl__links { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); font-size: var(--fs-small); }
  .tl__links a { display: inline-flex; align-items: center; gap: 0.35em; font-weight: 500; }
  .tl__links :global(svg) { width: 1em; transition: transform var(--dur-base) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .tl__links a:hover :global(svg) { transform: translateX(3px); } }
  .tl__item:target .tl__dot { background: var(--color-forest-ink); }
  .disclaimer { font-size: var(--fs-small); margin-top: var(--space-6); max-width: 52rem; }
  @media (max-width: 640px) {
    .tl__row { grid-template-columns: 1fr; gap: 0.2rem; }
    .tl__item { gap: var(--space-2); }
  }
  @media (prefers-reduced-motion: reduce) { .tl__links :global(svg) { transition: none; } }
</style>
