---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Marquee from '../components/Marquee.astro';
import Illustration from '../components/Illustration.astro';
import { annotate, terms } from '../data/terms.mjs';
import { tagToTerm, termHref, glossary } from '../data/slovnicek';
const chipTip = (c: string) => glossary.find((g) => g.id === tagToTerm[c])?.short ?? '';

// Fakta z NHS – ověřeno 7. 11. 2026 (revize stránek NHS 12/2025 a NHS 111 Wales 2021)
const NHS_FORMULA = 'https://www.nhs.uk/best-start-in-life/baby/feeding-your-baby/bottle-feeding/how-to-make-up-a-feed/how-to-use-formula/';
const NHS_AMOUNT = 'https://111.wales.nhs.uk/livewell/pregnancy/bottleformulacommonquest/';

const stages = [
  {
    age: '0 měsíců', label: 'Počáteční', tone: 'cream',
    note: 'Hlavní nápoj až do 1 roku, pokud dítě není kojené.',
    fact: '150–200 ml', factNote: 'na kilogram denně',
    sources: [{ label: 'NHS', href: NHS_FORMULA }, { label: 'NHS Wales', href: NHS_AMOUNT }],
    link: { label: 'Kolik mléka podle věku', href: '/mleka/kolik-mleka-podle-veku/' },
  },
  {
    age: '6 měsíců', label: 'Pokračovací', tone: 'sage',
    note: 'Podle britské NHS není nutné – počáteční mléko stačí celý první rok.',
    sources: [{ label: 'NHS', href: NHS_FORMULA }],
    link: { label: 'Počáteční vs. pokračovací', href: '/mleka/pocatecni-vs-pokracovaci/' },
  },
  {
    age: 'Po poradě s pediatrem', label: 'Speciální', tone: 'keylime',
    note: 'Při konkrétních obtížích dítěte.',
    chips: ['HA', 'AR', 'Comfort', 'Kozí'],
  },
];

const topics = [
  {
    href: '/mleka/', tone: 'sage', eyebrow: 'Klastr 1', illu: 'mleka' as const,
    title: 'Kojenecká mléka',
    text: 'Typy mlék, složení, značky na českém trhu a srovnávací tabulky.',
    ready: true,
  },
  {
    href: '/krmeni/', tone: 'mint', eyebrow: 'Klastr 2', illu: 'krmeni' as const,
    title: 'Krmení',
    text: 'Kojení, kombinované krmení, lahve, sterilizace a běžné obtíže.',
    ready: true,
  },
  {
    href: '/prikrmy/', tone: 'keylime', eyebrow: 'Klastr 3', illu: 'prikrmy' as const,
    title: 'Příkrmy',
    text: 'Kdy začít, jak na to a co zařadit v jakém věku.',
    ready: false,
  },
];

const sources = [
  { label: 'Světová zdravotnická organizace', href: 'https://www.who.int/' },
  { label: 'UNICEF', href: 'https://www.unicef.org/' },
  { label: 'ESPGHAN', href: 'https://www.espghan.org/' },
  { label: 'EFSA', href: 'https://www.efsa.europa.eu/' },
  { label: 'NHS', href: 'https://www.nhs.uk/' },
  { label: 'American Academy of Pediatrics', href: 'https://www.healthychildren.org/' },
  { label: 'CDC', href: 'https://www.cdc.gov/' },
  { label: 'Cochrane', href: 'https://www.cochranelibrary.com/' },
  { label: 'First Steps Nutrition Trust', href: 'https://www.firststepsnutrition.org/' },
];

const principles = [
  'Každé tvrzení má číslovaný odkaz na zdroj.',
  'U studií uvádíme autory, časopis a DOI.',
  'Neříkáme, které mléko je „nejlepší“, a nepropagujeme značky.',
];

const faq = [
  {
    q: 'Odkud berete informace?',
    a: 'Především z mezinárodních odborných institucí a přehledových studií – WHO, ESPGHAN, EFSA, britské NHS, americké pediatrické akademie AAP nebo Cochrane. Každý článek má na konci seznam zdrojů.',
  },
  {
    q: 'Doporučujete konkrétní značky?',
    a: 'Neříkáme, které mléko je „nejlepší“. Srovnáváme fakta ze složení a ceny, aby se rodiče mohli rozhodnout sami – ideálně spolu s pediatrem.',
  },
  {
    q: 'Nahrazuje web lékaře?',
    a: 'Ne. Pomáhá zorientovat se a položit lékaři správné otázky. Při jakýchkoli obtížích dítěte se vždy obraťte na pediatra.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Kojenecké mléko"
  description="Nezávislý průvodce kojeneckými mléky a krmením miminka. Typy mlék, složení, srovnávací tabulky a rady opřené o WHO, ESPGHAN a NHS."
  jsonLd={[faqLd]}
>
  <section class="container hero">
    <div class="hero__copy panel panel--keylime">
      <p class="eyebrow">Průvodce krmením miminka</p>
      <h1 class="display">Kojenecké mléko bez zmatku.</h1>
      <p class="lead">
        Srozumitelně o typech mlék, jejich složení a o tom, čím se doopravdy liší.
        Opíráme se o mezinárodní odborné zdroje, ne o reklamu.
      </p>
      <div class="hero__actions">
        <a href="/mleka/" class="btn btn--lg">Začít u mlék <Arrow /></a>
        <a href="/jak-tvorime-obsah/" class="btn btn--ghost btn--lg">Jak tvoříme obsah</a>
      </div>
      <Illustration name="sprig" class="hero__sprig" />
    </div>

    <div class="hero__visual panel panel--slate">
      <ol class="timeline" aria-label="Fáze kojeneckých mlék">
        {stages.map((st, i) => (
          <li class="stage" style={`--i:${i}`}>
            <span class:list={['stage__dot', `stage__dot--${st.tone}`]} aria-hidden="true"></span>
            <article class="stage__card panel panel--cream">
              <p class="eyebrow">{st.age}</p>
              <h2 class="heading-sm stage__title">{st.label}</h2>
              {st.fact && (
                <p class="stage__fact"><span class="serif tabular">{st.fact}</span> <span class="muted">{st.factNote}</span></p>
              )}
              <p class="muted small" set:html={annotate(st.note)} />
              {st.chips && (
                <ul class="stage__chips">{st.chips.map((c) => (
                  <li><a href={termHref(tagToTerm[c])} class="tag tag--sm tag--soft term term--chip" data-tip={chipTip(c)}>{c}</a></li>
                ))}</ul>
              )}
              {(st.link || st.sources) && (
                <p class="stage__foot">
                  {st.link && <a href={st.link.href} class="stage__link">{st.link.label} <Arrow /></a>}
                  {st.sources && (
                    <span class="stage__src">
                      {st.sources.length > 1 ? 'Zdroje: ' : 'Zdroj: '}
                      {st.sources.map((src, j) => <>{j > 0 && ', '}<a href={src.href} rel="noopener">{src.label}</a></>)}
                    </span>
                  )}
                </p>
              )}
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sources-strip" aria-labelledby="zdroje-pas">
    <p class="eyebrow container" id="zdroje-pas">Vycházíme z doporučení a výzkumu</p>
    <Marquee items={sources} label="Instituce, z jejichž doporučení vycházíme" />
  </section>

  <section class="container section" aria-labelledby="temata">
    <div class="section-head">
      <p class="eyebrow">Témata</p>
      <h2 id="temata">Od prvního mléka po první lžičku</h2>
    </div>
    <div class="topics">
      {topics.map((t) => (
        <a href={t.href} class:list={['topic', 'panel', `panel--${t.tone}`]}>
          <span class="topic__top">
            <span class="eyebrow">{t.eyebrow}</span>
            {!t.ready && <span class="tag tag--sm">Připravujeme</span>}
          </span>
          <h3 class="serif">{t.title}</h3>
          <p>{t.text}</p>
          <Illustration name={t.illu} bg="cream" class="topic__illu" />
          <span class="topic__more">Přejít <Arrow /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section method" aria-labelledby="metodika">
    <div class="method__grid">
      <div class="stack">
        <Illustration name="zdroje" class="method__illu" />
        <p class="eyebrow">Jak pracujeme</p>
        <h2 id="metodika">Každé tvrzení má svůj zdroj.</h2>
        <p class="lead">
          Čerpáme z doporučení mezinárodních zdravotnických institucí a z přehledových studií.
          České zdroje používáme pro to, co je místní – dostupnost a ceny mlék u nás.
        </p>
        <a href="/jak-tvorime-obsah/" class="btn">Naše metodika <Arrow /></a>
      </div>
      <div class="panel panel--sage method__panel">
        <p class="eyebrow">Na čem si zakládáme</p>
        <ul class="principles">
          {principles.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="container section" aria-labelledby="faq">
    <p class="eyebrow">Časté otázky</p>
    <h2 id="faq" class="visually-hidden">Časté otázky</h2>
    <dl class="faq">
      {faq.map((f) => (
        <div class="faq__row">
          <dt><h3 class="serif">{f.q}</h3></dt>
          <dd><p set:html={annotate(f.a)} /></dd>
        </div>
      ))}
    </dl>
  </section>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: 1.15fr 1fr; gap: var(--space-2);
    padding-top: var(--space-4);
  }
  .hero__copy { position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; gap: var(--space-3); padding-block: var(--space-6); }
  .hero__copy h1 { max-width: 11ch; }
  .hero__copy .lead { max-width: 34ch; }
  .hero__copy > :not(:global(.hero__sprig)) { position: relative; z-index: 1; }
  .hero__copy :global(.hero__sprig) {
    position: absolute; right: -1.25rem; bottom: -0.75rem; width: 10.5rem; pointer-events: none;
    animation: sprig-in 700ms var(--ease-out) both 150ms;
  }
  @keyframes sprig-in { from { opacity: 0; transform: translateY(12px); } }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }

  .hero__visual { display: grid; align-content: center; padding: var(--space-4); }
  .timeline { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); position: relative; }
  .timeline::before {
    content: ''; position: absolute; left: 0.5rem; top: 1.75rem; bottom: 1.75rem; width: 1.5px;
    background: var(--color-forest-ink); opacity: 0.35;
  }
  .stage {
    display: grid; grid-template-columns: 1rem 1fr; gap: var(--space-2); align-items: start;
    animation: rise 500ms var(--ease-out) both;
    animation-delay: calc(120ms + var(--i) * 70ms);
  }
  .stage__dot {
    position: relative; z-index: 1; margin-top: 1.4rem;
    width: 1rem; height: 1rem; border-radius: 50%;
    border: 1.5px solid var(--color-forest-ink); background: var(--color-cream-paper);
  }
  .stage__dot--sage { background: var(--color-sage-mist); }
  .stage__dot--keylime { background: var(--color-keylime-wash); }
  .stage__card { display: grid; gap: 0.3rem; padding: var(--space-3) var(--space-4); }
  .stage__title { font-size: 1.125rem; }
  .stage__fact { display: flex; align-items: baseline; gap: 0.4rem; flex-wrap: wrap; }
  .stage__fact .serif { font-size: 1.75rem; line-height: 1.1; color: var(--ink); font-weight: 300; }
  .stage__fact .muted { font-size: var(--fs-small); }
  .stage__chips { list-style: none; padding: 0; margin: 0.2rem 0 0; display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .stage__chips a { transition: background-color var(--dur-fast) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .stage__chips a:hover { background: var(--color-sage-mist); } }
  .stage__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-1) var(--space-2); margin-top: 0.35rem; font-size: var(--fs-small); }
  .stage__link { display: inline-flex; align-items: center; gap: 0.35em; text-decoration: none; }
  .stage__link :global(svg) { width: 1em; transition: transform var(--dur-base) var(--ease-out); }
  .stage__src { color: var(--text-muted); font-size: var(--fs-caption); }
  .stage__src a { color: inherit; }
  @media (hover: hover) and (pointer: fine) {
    .stage__link:hover { text-decoration: underline; }
    .stage__link:hover :global(svg) { transform: translateX(3px); }
  }
  .small { font-size: var(--fs-small); }

  @keyframes rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .section-head { margin-bottom: var(--space-5); }
  .section-head h2 { margin-top: var(--space-1); max-width: 20ch; }

  .topics { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); }
  .topic {
    display: flex; flex-direction: column; gap: var(--space-2);
    text-decoration: none; color: var(--text); min-height: 17rem;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .topic__top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); }
  .topic h3 { font-size: var(--fs-h2); line-height: 1.15; }
  .topic :global(.topic__illu) { width: 9.5rem; align-self: flex-end; margin-top: auto; margin-bottom: calc(-1 * var(--space-4)); transition: transform var(--dur-base) var(--ease-out); }
  .topic__more { margin-top: -1.5rem; display: inline-flex; align-items: center; gap: 0.4em; color: var(--ink); font-size: var(--fs-small); }
  .topic__more :global(svg) { width: 1em; transition: transform var(--dur-base) var(--ease-out); }
  .topic:active { transform: scale(0.99); }
  @media (hover: hover) and (pointer: fine) {
    .topic:hover .topic__more :global(svg) { transform: translateX(4px); }
    .topic:hover :global(.topic__illu) { transform: translateY(-4px); }
  }

  .method__grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-5); align-items: center; }
  .method__panel { position: relative; }
  .method :global(.method__illu) { width: 7.5rem; margin-left: -0.75rem; }
  .principles { list-style: none; padding: 0; margin-top: var(--space-3); display: grid; gap: var(--space-2); }
  .principles li { font-weight: 500; font-size: 1.0625rem; line-height: 1.4; color: var(--ink); padding-top: var(--space-2); border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); }
  .principles li:first-child { border-top: 0; padding-top: 0; }

  .sources-strip { padding-top: var(--space-6); }
  .sources-strip .eyebrow { display: block; text-align: center; }

  .faq { margin-top: var(--space-3); border-top: 1px solid var(--line); }
  .faq__row {
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5);
    padding-block: var(--space-5); border-bottom: 1px solid var(--line);
  }
  .faq h3 { font-size: var(--fs-h2); line-height: 1.2; }
  .faq dd p { color: var(--color-charcoal); }

  @media (max-width: 960px) {
    .hero, .method__grid { grid-template-columns: 1fr; }
    .hero__copy { padding-block: var(--space-5); }
    .topics { grid-template-columns: 1fr; }
    .topic { min-height: 0; }
    .hero__copy :global(.hero__sprig) { width: 7.5rem; right: -1rem; bottom: -0.75rem; }
    .hero__copy { padding-bottom: var(--space-6); }
    .faq__row { grid-template-columns: 1fr; gap: var(--space-2); padding-block: var(--space-4); }
  }
</style>
