---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Marquee from '../components/Marquee.astro';
import Illustration from '../components/Illustration.astro';
import ArticleCards from '../components/ArticleCards.astro';
import RecallList from '../components/RecallList.astro';
import AgePicker from '../components/AgePicker.astro';
import { clanekUrl, kontrolaUrl, stazeni, posledniKontrola, formatDatum } from '../data/stazeni';
import { situace, zacneteUrl } from '../data/situace';
import { nastroje } from '../data/nastroje';
import { clusterMeta } from '../data/clusters';
import { getCollection } from 'astro:content';
import { annotate, terms } from '../data/terms.mjs';
import { tagToTerm, termHref, glossary } from '../data/slovnicek';
const chipTip = (c: string) => glossary.find((g) => g.id === tagToTerm[c])?.short ?? '';

const vyrobkuSlovo = (n: number) => (n === 1 ? 'výrobek' : n >= 2 && n <= 4 ? 'výrobky' : 'výrobků');
// Stejně jako RecallBar: počet různých výrobků (jedno mléko ve více velikostech = 1)
const pocetVyrobku = new Set(stazeni.map((s) => s.vyrobek)).size;
const specialChips = ['HA', 'AR', 'Comfort', 'Kozí'];

// Nejnovější články po rubrikách – každý řádek jednotný (Příkrmy fotky, ostatní kresby)
const allArticles = (await getCollection('clanky', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf() || b.data.updated.valueOf() - a.data.updated.valueOf());
const latestByCluster = (['mleka', 'krmeni', 'prikrmy', 'batole'] as const).map((c) => ({
  cluster: c,
  articles: allArticles.filter((a) => a.data.cluster === c).slice(0, 3),
})).filter((g) => g.articles.length > 0);

const topics = [
  {
    href: '/mleka/', tone: 'sage', eyebrow: 'Klastr 1', illu: 'mleka' as const,
    title: 'Kojenecká mléka',
    text: 'Typy mlék, složení, značky na českém trhu a srovnávací tabulky.',
    ready: true,
  },
  {
    href: '/krmeni/', tone: 'mint', eyebrow: 'Klastr 2', illu: 'krmeni' as const,
    title: 'Krmení',
    text: 'Kojení, kombinované krmení, lahve, sterilizace a běžné obtíže.',
    ready: true,
  },
  {
    href: '/prikrmy/', tone: 'keylime', eyebrow: 'Klastr 3', illu: 'prikrmy' as const,
    title: 'Příkrmy',
    text: 'Kdy začít, jak na to a co zařadit v jakém věku.',
    ready: true,
  },
  {
    href: '/batole/', tone: 'slate', eyebrow: 'Klastr 4', illu: 'sprig' as const,
    title: 'Batole',
    text: 'Jídelníček, pití a vybíravost od 1 do 3 let.',
    ready: true,
  },
];

const sources = [
  { label: 'Světová zdravotnická organizace', href: 'https://www.who.int/' },
  { label: 'UNICEF', href: 'https://www.unicef.org/' },
  { label: 'ESPGHAN', href: 'https://www.espghan.org/' },
  { label: 'EFSA', href: 'https://www.efsa.europa.eu/' },
  { label: 'NHS', href: 'https://www.nhs.uk/' },
  { label: 'American Academy of Pediatrics', href: 'https://www.healthychildren.org/' },
  { label: 'CDC', href: 'https://www.cdc.gov/' },
  { label: 'Cochrane', href: 'https://www.cochranelibrary.com/' },
  { label: 'First Steps Nutrition Trust', href: 'https://www.firststepsnutrition.org/' },
];

const principles = [
  'Každé tvrzení má číslovaný odkaz na zdroj.',
  'U studií uvádíme autory, časopis a DOI.',
  'Neříkáme, které mléko je „nejlepší“, a nepropagujeme značky.',
];

const faq = [
  {
    q: 'Odkud berete informace?',
    a: 'Především z mezinárodních odborných institucí a přehledových studií – WHO, ESPGHAN, EFSA, britské NHS, americké pediatrické akademie AAP nebo Cochrane. Každý článek má na konci seznam zdrojů.',
  },
  {
    q: 'Doporučujete konkrétní značky?',
    a: 'Neříkáme, které mléko je „nejlepší“. Srovnáváme fakta ze složení a ceny, aby se rodiče mohli rozhodnout sami – ideálně spolu s pediatrem.',
  },
  {
    q: 'Nahrazuje web lékaře?',
    a: 'Ne. Pomáhá zorientovat se a položit lékaři správné otázky. Při jakýchkoli obtížích dítěte se vždy obraťte na pediatra.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  alternates={{ cs: '/', sk: '/sk/' }}
  title="Kojenecké mléko"
  description="Nezávislý průvodce kojeneckými mléky a krmením miminka. Typy mlék, složení, srovnávací tabulky a rady opřené o WHO, ESPGHAN a NHS."
  jsonLd={[faqLd]}
>
  <section class="container hero">
    <div class="hero__copy panel panel--keylime">
      <p class="eyebrow">Průvodce krmením miminka</p>
      <h1 class="display">Kojenecké mléko bez zmatku.</h1>
      <p class="lead">
        Srozumitelně o typech mlék, jejich složení a o tom, čím se doopravdy liší.
        Opíráme se o mezinárodní odborné zdroje, ne o reklamu.
      </p>
      <div class="hero__actions">
        <a href="/mleka/" class="btn btn--lg">Začít u mlék <Arrow /></a>
        <a href={zacneteUrl} class="btn btn--ghost btn--lg hero__ghost">Kde začít podle situace</a>
      </div>
      <nav class="hero__clusters" aria-label="Rubriky">
        {topics.map((t) => <a href={t.href} class="hero__cluster">{t.title} <Arrow /></a>)}
      </nav>
      <Illustration name="sprig" class="hero__sprig" />
    </div>

    <div class="hero__visual panel panel--slate">
      <AgePicker />
      <p class="hero__special">
        <span>Speciální mléka jen po poradě s pediatrem:</span>
        {specialChips.map((c) => (
          <a href={termHref(tagToTerm[c])} class="tag tag--sm tag--soft term term--chip" data-tip={chipTip(c)}>{c}</a>
        ))}
      </p>
    </div>
  </section>

  <section class="container recall" aria-labelledby="stazena">
    <details class="recall__panel">
      <summary class="recall__summary">
        <span class="recall__dot" aria-hidden="true"></span>
        <span class="recall__text">
          <strong id="stazena">Stažená kojenecká mléka: {pocetVyrobku} {vyrobkuSlovo(pocetVyrobku)} na seznamu</strong>
          <span class="recall__meta">Ověřeno na webech SZPI a Ministerstva zdravotnictví {formatDatum(posledniKontrola)}</span>
        </span>
        <span class="recall__toggle"><span class="recall__show">Zobrazit seznam</span><span class="recall__hide">Skrýt seznam</span></span>
      </summary>
      <div class="recall__body">
        <p class="recall__lead">
          Pokud sedí název, velikost a datum minimální trvanlivosti, mléko miminku nepodávejte a balení si nechte.
        </p>
        <RecallList />
      </div>
    </details>
    <p class="recall__actions">
      <a href={kontrolaUrl} class="btn">Zkontrolovat moje balení <Arrow /></a>
      <a href={clanekUrl} class="recall__more">Co dělat a kdy k lékaři</a>
    </p>
  </section>

  <section class="container section situations" aria-labelledby="situace">
    <div class="section-head section-head--row">
      <div>
        <p class="eyebrow">Začněte tady</p>
        <h2 id="situace">Co právě řešíte?</h2>
      </div>
      <a href={zacneteUrl} class="latest-group__all">Všechny situace <Arrow /></a>
    </div>
    <ul class="situations__list">
      {situace.map((s, i) => (
        <li style={`--i:${i}`}>
          <a href={`${zacneteUrl}#${s.id}`} class:list={['situation', 'panel', `panel--${s.tone}`]}>
            <span class="situation__n">{s.clanky.length} {s.clanky.length >= 5 ? 'článků' : 'články'}</span>
            <h3 class="heading-sm">{s.title}</h3>
            <p>{s.text}</p>
            <span class="situation__more">Číst v pořadí <Arrow /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="sources-strip" aria-labelledby="zdroje-pas">
    <p class="eyebrow container" id="zdroje-pas">Vycházíme z doporučení a výzkumu</p>
    <Marquee items={sources} label="Instituce, z jejichž doporučení vycházíme" />
  </section>

  <section class="container section" aria-labelledby="temata">
    <div class="section-head">
      <p class="eyebrow">Témata</p>
      <h2 id="temata">Od prvního mléka po rodinný stůl</h2>
    </div>
    <div class="topics">
      {topics.map((t) => (
        <a href={t.href} class:list={['topic', 'panel', `panel--${t.tone}`]}>
          <span class="topic__top">
            <span class="eyebrow">{t.eyebrow}</span>
            {!t.ready && <span class="tag tag--sm">Připravujeme</span>}
          </span>
          <h3 class="serif">{t.title}</h3>
          <p>{t.text}</p>
          <Illustration name={t.illu} bg="cream" class="topic__illu" />
          <span class="topic__more">Přejít <Arrow /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section tools" aria-labelledby="nastroje">
    <div class="section-head section-head--row">
      <div>
        <p class="eyebrow">Nástroje · zdarma, bez registrace</p>
        <h2 id="nastroje">Pomůcky pro každý den</h2>
      </div>
      <a href="/nastroje/" class="latest-group__all">Všechny nástroje <Arrow /></a>
    </div>
    <ul class="tools__list">
      {nastroje.slice(0, 3).map((n) => (
        <li>
          <a href={n.href} class:list={['tool', 'panel', `panel--${n.tone}`]}>
            <h3 class="heading-sm">{n.title}</h3>
            <p>{n.text}</p>
            <span class="tool__more">{n.cta} <Arrow /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container section" aria-labelledby="nejnovejsi">
    <div class="section-head section-head--row">
      <div>
        <p class="eyebrow">Nejnovější články</p>
        <h2 id="nejnovejsi">Čerstvě ověřeno ve zdrojích</h2>
      </div>
    </div>
    {latestByCluster.map((g) => (
      <div class="latest-group">
        <div class="latest-group__head">
          <h3 class="heading-sm"><span class:list={['latest-group__dot', `panel--${clusterMeta[g.cluster].tone}`]} aria-hidden="true"></span>{clusterMeta[g.cluster].title}</h3>
          <a href={`/${g.cluster}/`} class="latest-group__all">Všechny články <Arrow /></a>
        </div>
        <ArticleCards articles={g.articles} showCluster={false} feature />
      </div>
    ))}
  </section>

  <section class="container section method" aria-labelledby="metodika">
    <div class="method__grid">
      <div class="stack">
        <Illustration name="zdroje" class="method__illu" />
        <p class="eyebrow">Jak pracujeme</p>
        <h2 id="metodika">Každé tvrzení má svůj zdroj.</h2>
        <p class="lead">
          Čerpáme z doporučení mezinárodních zdravotnických institucí a z přehledových studií.
          České zdroje používáme pro to, co je místní – dostupnost a ceny mlék u nás.
        </p>
        <a href="/jak-tvorime-obsah/" class="btn">Naše metodika <Arrow /></a>
      </div>
      <div class="panel panel--sage method__panel">
        <p class="eyebrow">Na čem si zakládáme</p>
        <ul class="principles">
          {principles.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="container section" aria-labelledby="faq">
    <p class="eyebrow">Časté otázky</p>
    <h2 id="faq" class="visually-hidden">Časté otázky</h2>
    <dl class="faq">
      {faq.map((f) => (
        <div class="faq__row">
          <dt><h3 class="serif">{f.q}</h3></dt>
          <dd><p set:html={annotate(f.a)} /></dd>
        </div>
      ))}
    </dl>
  </section>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: 1.15fr 1fr; gap: var(--space-2);
    padding-top: var(--space-4);
  }
  .hero__copy { position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; gap: var(--space-3); padding-block: var(--space-6); }
  .hero__copy h1 { max-width: 11ch; }
  .hero__copy .lead { max-width: 34ch; }
  .hero__copy > :not(:global(.hero__sprig)) { position: relative; z-index: 1; }
  .hero__copy :global(.hero__sprig) {
    position: absolute; right: -1.25rem; bottom: -0.75rem; width: 10.5rem; pointer-events: none;
    animation: sprig-in 700ms var(--ease-out) both 150ms;
  }
  @keyframes sprig-in { from { opacity: 0; transform: translateY(12px); } }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }

  .hero__visual { display: grid; align-content: center; gap: var(--space-3); padding: var(--space-4); animation: rise 500ms var(--ease-out) both 120ms; }
  .hero__special { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; margin: 0; font-size: var(--fs-small); color: var(--color-charcoal); }
  .hero__special span { margin-right: 0.25rem; }
  .hero__special a { transition: background-color var(--dur-fast) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .hero__special a:hover { background: var(--color-sage-mist); } }
  .hero__clusters { display: none; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .section-head { margin-bottom: var(--space-5); }
  .section-head h2 { margin-top: var(--space-1); max-width: 20ch; }
  .section-head--row { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-2) var(--space-4); flex-wrap: wrap; }
  .recall { margin-top: var(--space-2); display: grid; grid-template-columns: 1fr auto; gap: var(--space-2); align-items: start; }
  .recall__panel { background: var(--color-alert-wash); border: 1px solid var(--color-alert-line); border-radius: var(--radius-card); }
  .recall__summary {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-2);
    padding: var(--space-2) var(--space-3); cursor: pointer; list-style: none;
  }
  .recall__summary::-webkit-details-marker { display: none; }
  .recall__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-alert-ink); }
  .recall__text { display: grid; gap: 0.1rem; }
  .recall__text strong { color: var(--color-alert-ink); font-weight: 600; }
  .recall__meta { font-size: var(--fs-small); color: var(--text-muted); }
  .recall__toggle { font-size: var(--fs-small); font-weight: 500; color: var(--color-alert-ink); display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap; }
  .recall__toggle::after {
    content: ''; width: 0.45rem; height: 0.45rem; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: translateY(-25%) rotate(45deg); transition: transform var(--dur-base) var(--ease-out);
  }
  .recall__panel[open] .recall__toggle::after { transform: translateY(15%) rotate(-135deg); }
  .recall__hide, .recall__panel[open] .recall__show { display: none; }
  .recall__panel[open] .recall__hide { display: inline; }
  @media (prefers-reduced-motion: reduce) { .recall__toggle::after { transition: none; } }
  .recall__body { padding: 0 var(--space-3) var(--space-3); }
  .recall__lead { margin: 0 0 var(--space-2); color: var(--color-charcoal); font-size: var(--fs-small); }
  .recall__actions { display: flex; flex-direction: column; align-items: stretch; gap: 0.3rem; margin: 0; text-align: center; }
  .recall__more { font-size: var(--fs-small); color: var(--text-muted); }
  @media (max-width: 760px) {
    .recall { grid-template-columns: 1fr; }
    .recall__summary { grid-template-columns: auto 1fr; }
    .recall__toggle { grid-column: 2; }
    .recall__actions { flex-direction: row; flex-wrap: wrap; align-items: center; gap: var(--space-2); text-align: left; }
  }

  .situations__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); }
  .situations__list > li { animation: rise 420ms var(--ease-out) both; animation-delay: calc(var(--i) * 40ms); }
  .situation { display: flex; flex-direction: column; gap: var(--space-1); height: 100%; padding: var(--space-4); text-decoration: none; color: var(--text); transition: transform var(--dur-fast) var(--ease-out); }
  .situation h3 { margin: 0; font-size: var(--fs-h3); color: var(--ink); }
  .situation p { font-size: var(--fs-small); color: var(--color-charcoal); }
  .situation__n { font-size: var(--fs-caption); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .situation__more { margin-top: auto; padding-top: var(--space-1); display: inline-flex; align-items: center; gap: 0.4em; color: var(--ink); font-size: var(--fs-small); font-weight: 500; }
  .situation__more :global(svg) { width: 1em; transition: transform var(--dur-base) var(--ease-out); }
  .situation:active { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) {
    .situation:hover .situation__more :global(svg) { transform: translateX(4px); }
    .situation:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  }
  @media (max-width: 960px) { .situations__list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) {
    .situations__list { grid-template-columns: 1fr; gap: 0.5rem; }
    .situation { padding: var(--space-3); }
  }
  .section-head__links { font-size: var(--fs-small); color: var(--text-muted); }
  .latest-group + .latest-group { margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .latest-group__head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-2); margin-bottom: var(--space-3); }
  .latest-group__head h3 { margin: 0; font-size: var(--fs-h3); color: var(--ink); display: inline-flex; align-items: center; gap: 0.6rem; }
  .latest-group__dot { width: 0.9rem; height: 0.9rem; border-radius: 50%; border: 1.5px solid var(--color-forest-ink); }
  .latest-group__all { display: inline-flex; align-items: center; gap: 0.4em; font-size: var(--fs-small); font-weight: 500; color: var(--ink); }
  .latest-group__all :global(svg) { width: 1em; transition: transform var(--dur-base) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .latest-group__all:hover :global(svg) { transform: translateX(4px); } }

  .tools { padding-top: 0; }
  .tools__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); }
  .tool { display: flex; flex-direction: column; gap: var(--space-1); height: 100%; padding: var(--space-4); text-decoration: none; color: var(--text); transition: transform var(--dur-fast) var(--ease-out); }
  .tool p { font-size: var(--fs-small); color: var(--color-charcoal); }
  .tool__more { margin-top: auto; padding-top: var(--space-2); display: inline-flex; align-items: center; gap: 0.4em; color: var(--ink); font-size: var(--fs-small); font-weight: 500; }
  .tool__more :global(svg) { width: 1em; transition: transform var(--dur-base) var(--ease-out); }
  .tool:active { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) { .tool:hover .tool__more :global(svg) { transform: translateX(4px); } .tool:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; } }
  @media (max-width: 960px) { .tools__list { grid-template-columns: 1fr; } }

  .topics { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-2); }
  @media (max-width: 1100px) { .topics { grid-template-columns: repeat(2, 1fr); } }
  .topic {
    display: flex; flex-direction: column; gap: var(--space-2);
    text-decoration: none; color: var(--text); min-height: 17rem;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .topic__top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); }
  .topic h3 { font-size: var(--fs-h2); line-height: 1.15; }
  .topic :global(.topic__illu) { width: 9.5rem; align-self: flex-end; margin-top: auto; margin-bottom: calc(-1 * var(--space-4)); transition: transform var(--dur-base) var(--ease-out); }
  .topic__more { margin-top: -1.5rem; display: inline-flex; align-items: center; gap: 0.4em; color: var(--ink); font-size: var(--fs-small); }
  .topic__more :global(svg) { width: 1em; transition: transform var(--dur-base) var(--ease-out); }
  .topic:active { transform: scale(0.99); }
  @media (hover: hover) and (pointer: fine) {
    .topic:hover .topic__more :global(svg) { transform: translateX(4px); }
    .topic:hover :global(.topic__illu) { transform: translateY(-4px); }
  }

  .method__grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-5); align-items: center; }
  .method__panel { position: relative; }
  .method :global(.method__illu) { width: 7.5rem; margin-left: -0.75rem; }
  .principles { list-style: none; padding: 0; margin-top: var(--space-3); display: grid; gap: var(--space-2); }
  .principles li { font-weight: 500; font-size: 1.0625rem; line-height: 1.4; color: var(--ink); padding-top: var(--space-2); border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); }
