---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import FoodLog from '../../components/FoodLog.astro';

const url = new URL('/nastroje/zapisnik-prikrmu/', Astro.site).toString();

const steps = [
  { t: 'Klepněte na potravinu', d: 'Potraviny jsou rozdělené do skupin podle britské NHS: zelenina, ovoce, přílohy, bílkoviny a mléčné výrobky. Chybí-li vám nějaká, přidejte si ji.' },
  { t: 'Zapište datum a jak chutnalo', d: 'Chutnalo, napůl, nebo nechutnalo – a krátkou poznámku, třeba v jaké podobě miminko jídlo dostalo. Když máte podezření na reakci, zaškrtněte to.' },
  { t: 'Mějte přehled', d: 'U každé potraviny vidíte, kolikrát a kdy ji miminko mělo. Záznamy si můžete stáhnout jako tabulku.' },
];

const faq = [
  {
    q: 'Poradí mi zápisník, co a kdy dát?',
    a: 'Ne. Zápisník jen eviduje, co už miminko ochutnalo a jak mu to chutnalo. Čím začít a co nabízet v jakém věku, popisujeme v článcích První příkrmy a Jídelníček miminka podle věku.',
  },
  {
    q: 'Miminku něco nechutnalo. Mám to přestat nabízet?',
    a: 'Podle NHS může trvat i 10 a více pokusů, než si miminko na novou chuť nebo texturu zvykne. Zápisník vám pomůže vidět, kolikrát už jídlo dostalo.',
  },
  {
    q: 'Proč jsou alergeny zvlášť?',
    a: 'Alergeny jako vejce, arašídy nebo lepek se zavádějí po jednom a v malém množství, aby šla případná reakce poznat. Pro ně je samostatný zápisník alergenů se seznamem podle NHS.',
  },
  {
    q: 'Kde jsou moje záznamy uložené?',
    a: 'Jen v úložišti prohlížeče ve vašem telefonu nebo počítači. Na náš server se neposílají a nevidíme je. Do jiného zařízení se nepřenesou a zmizí, když vymažete data prohlížeče.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Úvod', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Nástroje', item: new URL('/nastroje/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: 'Zápisník příkrmů', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Zápisník příkrmů',
    url,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web',
    inLanguage: 'cs-CZ',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'CZK' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title="Zápisník příkrmů – co už miminko ochutnalo a jak mu chutnalo"
  description="Zápisník příkrmů zdarma: zapište, kdy miminko ochutnalo brokolici, mrkev, jablko, maso nebo čočku a jak mu chutnalo. Bez registrace, data zůstávají v telefonu."
  jsonLd={jsonLd}
  ogImage="/images/og/nastroj-zapisnik-prikrmu.png"
>
  <div class="container page">
    <header class="stack head">
      <nav class="crumbs" aria-label="Drobečková navigace"><a href="/">Úvod</a> <span aria-hidden="true">/</span> <a href="/nastroje/">Nástroje</a></nav>
      <p class="eyebrow">Nástroj · zdarma, bez registrace</p>
      <h1>Zápisník příkrmů</h1>
      <p class="lead">Brokolice, mrkev, banán, čočka… Zapište si, co už miminko ochutnalo, kdy a jak mu chutnalo.</p>
    </header>

    <FoodLog />

    <section class="block" aria-labelledby="jak">
      <h2 id="jak">Jak zápisník funguje</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li><span class="heading-sm">{s.t}</span><span>{s.d}</span></li>
        ))}
      </ol>
    </section>

    <section class="block" aria-labelledby="otazky">
      <h2 id="otazky">Časté otázky</h2>
      <dl class="faq">
        {faq.map((f) => (
          <div>
            <dt class="heading-sm">{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="block" aria-labelledby="dal">
      <h2 id="dal">Podrobně v článcích</h2>
      <ul class="links">
        <li><a href="/prikrmy/prvni-prikrmy/">První příkrmy krok za krokem <Arrow /></a></li>
        <li><a href="/prikrmy/recepty-na-prikrmy/">Recepty na příkrmy <Arrow /></a></li>
        <li><a href="/prikrmy/odmita-prikrmy/">Miminko odmítá příkrmy <Arrow /></a></li>
        <li><a href="/nastroje/zapisnik-alergenu/">Zápisník alergenů <Arrow /></a></li>
      </ul>
    </section>

    <p class="muted small disclaimer">
      Zápisník je pomůcka k zapisování. Nenahrazuje radu pediatra. Při potížích s dýcháním nebo otoku jazyka či hrdla volejte 155.
    </p>
  </div>
</Base>

<style>
  .page { max-width: calc(40rem + 2 * var(--gutter)); padding-top: var(--space-5); }
  .head { margin-bottom: var(--space-4); }
  @media (max-width: 640px) {
    .page { padding-top: var(--space-3); }
    .head { margin-bottom: var(--space-3); }
    .head > * + * { margin-top: var(--space-1); }
    .head h1 { font-size: 2rem; }
    .head .lead { font-size: var(--fs-body); }
  }
  .crumbs { font-size: var(--fs-small); color: var(--text-muted); }
  .crumbs a { color: var(--text-muted); }
  .block { margin-top: var(--space-6); display: grid; gap: var(--space-2); }
  .steps { list-style: none; padding: 0; margin-top: var(--space-2); display: grid; gap: var(--space-1); }
  .steps li { background: var(--color-keylime-wash); border-radius: var(--radius-card); padding: var(--space-3) var(--space-4); display: grid; gap: 0.3rem; }
  .faq { display: grid; margin-top: var(--space-2); border-top: 1px solid var(--line); }
  .faq > div { padding-block: var(--space-3); border-bottom: 1px solid var(--line); display: grid; gap: var(--space-1); }
  .faq dd { margin: 0; color: var(--color-charcoal); }
  .links { list-style: none; padding: 0; display: grid; gap: var(--space-1); }
  .links a { display: inline-flex; align-items: center; gap: 0.35em; font-weight: 500; }
  .links :global(svg) { width: 1em; transition: transform var(--dur-base) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .links a:hover :global(svg) { transform: translateX(3px); } }
  .disclaimer { margin-top: var(--space-4); }
  .small { font-size: var(--fs-small); }
</style>
