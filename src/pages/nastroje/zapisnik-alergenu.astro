---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import AllergenLog from '../../components/AllergenLog.astro';

const url = new URL('/nastroje/zapisnik-alergenu/', Astro.site).toString();

const steps = [
  { t: 'Klepněte na potravinu', d: 'V seznamu je dvanáct alergenů, které uvádí britská NHS: od kravského mléka a vajec po celer a hořčici.' },
  { t: 'Zapište datum a poznámku', d: 'Třeba v jaké podobě miminko potravinu dostalo. Když máte podezření na reakci, zaškrtněte to.' },
  { t: 'Mějte přehled', d: 'U každé potraviny vidíte, kolikrát a kdy naposledy ji miminko mělo. Záznamy si můžete stáhnout a ukázat pediatrovi.' },
];

const faq = [
  {
    q: 'Poradí mi zápisník, kdy který alergen zavést?',
    a: 'Ne. Zápisník jen eviduje, co už miminko ochutnalo. Jak alergeny zavádět, popisujeme v článku Zavádění alergenů; u miminek s ekzémem, potvrzenou alergií nebo alergiemi v rodině se podle NHS předem poraďte s pediatrem.',
  },
  {
    q: 'Které potraviny patří mezi alergeny?',
    a: 'Podle NHS kravské mléko, vejce, potraviny s lepkem, ořechy a arašídy, semínka (hlavně sezam), sója, korýši a ryby, dále luštěniny, celer a hořčice.',
  },
  {
    q: 'Co dělat při podezření na alergickou reakci?',
    a: 'Poraďte se s pediatrem. Pokud má miminko potíže s dýcháním, otéká mu jazyk nebo hrdlo nebo má vystouplou svědivou vyrážku, volejte 155.',
  },
  {
    q: 'Kde jsou moje záznamy uložené?',
    a: 'Jen v úložišti prohlížeče ve vašem telefonu nebo počítači. Na náš server se neposílají a nevidíme je. Do jiného zařízení se nepřenesou a zmizí, když vymažete data prohlížeče.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Úvod', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Nástroje', item: new URL('/nastroje/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: 'Zápisník alergenů', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Zápisník alergenů v příkrmech',
    url,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web',
    inLanguage: 'cs-CZ',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'CZK' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title="Zápisník alergenů v příkrmech – co už miminko ochutnalo"
  description="Jednoduchý zápisník alergenů zdarma: zapište, kdy miminko poprvé ochutnalo vejce, arašídy, lepek, ryby a další. Bez registrace, data zůstávají ve vašem telefonu."
  jsonLd={jsonLd}
  ogImage="/images/og/nastroj-zapisnik-alergenu.png"
>
  <div class="container page">
    <header class="stack head">
      <nav class="crumbs" aria-label="Drobečková navigace"><a href="/">Úvod</a> <span aria-hidden="true">/</span> <a href="/nastroje/">Nástroje</a></nav>
      <p class="eyebrow">Nástroj · zdarma, bez registrace</p>
      <h1>Zápisník alergenů</h1>
      <p class="lead">Vejce, arašídy, lepek, ryby… Zapište si, co už miminko ochutnalo a kdy. Přehled se hodí i u pediatra.</p>
    </header>

    <AllergenLog />

    <section class="block" aria-labelledby="jak">
      <h2 id="jak">Jak zápisník funguje</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li><span class="heading-sm">{s.t}</span><span>{s.d}</span></li>
        ))}
      </ol>
    </section>

    <section class="block" aria-labelledby="otazky">
      <h2 id="otazky">Časté otázky</h2>
      <dl class="faq">
        {faq.map((f) => (
          <div>
            <dt class="heading-sm">{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="block" aria-labelledby="dal">
      <h2 id="dal">Podrobně v článcích</h2>
      <ul class="links">
        <li><a href="/prikrmy/alergeny/">Zavádění alergenů <Arrow /></a></li>
        <li><a href="/prikrmy/prvni-prikrmy/">První příkrmy krok za krokem <Arrow /></a></li>
        <li><a href="/krmeni/alergie-na-bilkovinu-kravskeho-mleka/">Alergie na bílkovinu kravského mléka <Arrow /></a></li>
      </ul>
    </section>

    <p class="muted small disclaimer">
      Zápisník je pomůcka k zapisování. Nenahrazuje radu pediatra ani alergologa. Při potížích s dýcháním nebo otoku jazyka či hrdla volejte 155.
    </p>
  </div>
</Base>

<style>
  .page { max-width: calc(40rem + 2 * var(--gutter)); padding-top: var(--space-5); }
  .head { margin-bottom: var(--space-4); }
  @media (max-width: 640px) {
    .page { padding-top: var(--space-3); }
    .head { margin-bottom: var(--space-3); }
    .head > * + * { margin-top: var(--space-1); }
    .head h1 { font-size: 2rem; }
    .head .lead { font-size: var(--fs-body); }
  }
  .crumbs { font-size: var(--fs-small); color: var(--text-muted); }
  .crumbs a { color: var(--text-muted); }
  .block { margin-top: var(--space-6); display: grid; gap: var(--space-2); }
  .steps { list-style: none; padding: 0; margin-top: var(--space-2); display: grid; gap: var(--space-1); }
  .steps li { background: var(--color-keylime-wash); border-radius: var(--radius-card); padding: var(--space-3) var(--space-4); display: grid; gap: 0.3rem; }
  .faq { display: grid; margin-top: var(--space-2); border-top: 1px solid var(--line); }
  .faq > div { padding-block: var(--space-3); border-bottom: 1px solid var(--line); display: grid; gap: var(--space-1); }
  .faq dd { margin: 0; color: var(--color-charcoal); }
  .links { list-style: none; padding: 0; display: grid; gap: var(--space-1); }
  .links a { display: inline-flex; align-items: center; gap: 0.35em; font-weight: 500; }
  .links :global(svg) { width: 1em; transition: transform var(--dur-base) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .links a:hover :global(svg) { transform: translateX(3px); } }
  .disclaimer { margin-top: var(--space-4); }
  .small { font-size: var(--fs-small); }
</style>
