---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MilkTable from '../../components/MilkTable.astro';
import Marquee from '../../components/Marquee.astro';

const stageOrder = { pocatecni: 0, pokracovaci: 1, batoleci: 2 } as const;
const milks = (await getCollection('mleka')).sort(
  (a, b) => stageOrder[a.data.stage] - stageOrder[b.data.stage] || a.data.brand.localeCompare(b.data.brand, 'cs'),
);
// Faktický výčet značek ve srovnání – jen text, bez log a odkazů. Zobrazí se až s ověřenými daty.
const brands = [...new Set(milks.map((m) => m.data.brand))]
  .sort((a, b) => a.localeCompare(b, 'cs'))
  .map((label) => ({ label }));
---
<Base
  title="Srovnání kojeneckých mlék"
  description="Srovnání počátečních kojeneckých mlék dostupných v ČR: základ, HMO, palmový olej a probiotika podle složení na webu výrobce. Bez hodnocení, s datem ověření."
>
  <section class="container head">
    <nav class="crumbs" aria-label="Drobečková navigace">
      <a href="/">Úvod</a> <span aria-hidden="true">/</span> <a href="/mleka/">Kojenecká mléka</a>
    </nav>
    <p class="eyebrow">Srovnání</p>
    <h1>Srovnání kojeneckých mlék</h1>
    <p class="lead">
      Fakta ze složení na jednom místě. Tabulka neříká, které mléko je nejlepší –
      pomáhá porovnat, čím se mléka liší.
    </p>
  </section>

  {brands.length >= 4 && (
    <section class="brands" aria-labelledby="znacky">
      <p class="eyebrow container" id="znacky">Ve srovnání najdete</p>
      <Marquee items={brands} label="Značky zahrnuté ve srovnání" />
    </section>
  )}

  <section class="container">
    <MilkTable milks={milks} />
    <div class="notes">
      <p class="muted note">
        Údaje přebíráme ze složení na oficiálních webech výrobců (odkaz u názvu mléka); u každého mléka je datum ověření.
        Složení se může změnit – rozhodující je vždy obal výrobku, který máte doma. Připravujte podle návodu na balení.
      </p>
      <p class="muted note">
        Všechna počáteční mléka prodávaná v EU musí splňovat stejné požadavky na složení podle nařízení (EU) 2016/127.
        Kojení je podle WHO doporučeným způsobem výživy kojenců.
      </p>
      <p class="muted note">
        U některých šarží Nutrilon Profutura Duobiotik 1 probíhá stahování z trhu – ověřte DMT v článku{' '}
        <a href="/mleka/stazena-kojenecka-mleka/">Stažená kojenecká mléka 2026</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .head { display: grid; gap: var(--space-2); padding-block: var(--space-6) var(--space-5); }
  .crumbs { font-size: var(--fs-small); }
  .crumbs a { color: var(--text-muted); }
  .brands { margin-bottom: var(--space-3); }
  .brands .eyebrow { display: block; }
  .notes { display: grid; gap: var(--space-2); margin-top: var(--space-3); max-width: 70ch; }
  .note { font-size: var(--fs-small); }
</style>
