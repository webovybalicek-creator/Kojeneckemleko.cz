---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MilkTable from '../../components/MilkTable.astro';
import Marquee from '../../components/Marquee.astro';

const milks = (await getCollection('mleka')).sort(
  (a, b) => a.data.brand.localeCompare(b.data.brand, 'cs') || a.data.name.localeCompare(b.data.name, 'cs'),
);
const specialTypes = ['HA', 'AR', 'bez-laktozy'];
const isSpecial = (m: (typeof milks)[number]) => m.data.types.some((t) => specialTypes.includes(t));
const groups = [
  {
    id: 'pocatecni', title: 'Počáteční mléka', sub: 'Od narození. Jediné mléko, které miminko v 1. roce potřebuje, pokud není kojené.',
    milks: milks.filter((m) => m.data.stage === 'pocatecni' && !isSpecial(m)),
  },
  {
    id: 'pokracovaci', title: 'Pokračovací mléka', sub: 'Od ukončeného 6. měsíce, vedle příkrmů. Podle NHS nejsou nutná – počáteční mléko stačí celý 1. rok.',
    milks: milks.filter((m) => m.data.stage === 'pokracovaci' && !isSpecial(m)),
  },
  {
    id: 'specialni', title: 'Speciální mléka', sub: 'HA, AR a bez laktózy – jen po poradě s pediatrem. Některá jsou potravinou pro zvláštní lékařské účely.',
    milks: milks.filter(isSpecial),
  },
].filter((g) => g.milks.length > 0);
// Faktický výčet značek ve srovnání – jen text, bez log a odkazů. Zobrazí se až s ověřenými daty.
const brands = [...new Set(milks.map((m) => m.data.brand))]
  .sort((a, b) => a.localeCompare(b, 'cs'))
  .map((label) => ({ label }));
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Úvod', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'Kojenecká mléka', item: new URL('/mleka/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: 'Srovnání kojeneckých mlék', item: new URL('/mleka/srovnani/', Astro.site).toString() },
  ],
};
---
<Base
  title="Srovnání kojeneckých mlék"
  description="Srovnání počátečních, pokračovacích a speciálních (HA, AR, bez laktózy) kojeneckých mlék v ČR: HMO, palmový olej, probiotika, ceny. Bez hodnocení."
  jsonLd={[breadcrumbs]}
>
  <section class="container head">
    <nav class="crumbs" aria-label="Drobečková navigace">
      <a href="/">Úvod</a> <span aria-hidden="true">/</span> <a href="/mleka/">Kojenecká mléka</a>
    </nav>
    <p class="eyebrow">Srovnání</p>
    <h1>Srovnání kojeneckých mlék</h1>
    <p class="lead">
      Fakta ze složení a orientační ceny na jednom místě. Tabulka neříká, které mléko je nejlepší –
      pomáhá porovnat, čím se mléka liší.
    </p>
  </section>

  {brands.length >= 4 && (
    <section class="brands" aria-labelledby="znacky">
      <p class="eyebrow container" id="znacky">Ve srovnání najdete</p>
      <Marquee items={brands} label="Značky zahrnuté ve srovnání" />
    </section>
  )}

  <nav class="container jump" aria-label="Skupiny mlék">
    {groups.map((g) => <a href={`#${g.id}`} class="tag">{g.title} <span>{g.milks.length}</span></a>)}
  </nav>

  {groups.map((g) => (
    <section class="container group" id={g.id} aria-labelledby={`${g.id}-h`}>
      <div class="group__head">
        <h2 id={`${g.id}-h`}>{g.title}</h2>
        <p class="muted">{g.sub}</p>
      </div>
      <MilkTable milks={g.milks} caption={g.title} />
    </section>
  ))}

  <section class="container">
    <div class="notes">
      <p class="muted note">
        Speciální mléka (HA, AR, bez laktózy) nejsou určena pro všechna miminka. Podávejte je jen po poradě s pediatrem –
        víc v článcích <a href="/mleka/ha-mleko/">HA mléko</a>, <a href="/mleka/ar-mleko/">AR mléko</a> a
        <a href="/krmeni/alergie-na-bilkovinu-kravskeho-mleka/">alergie na bílkovinu kravského mléka</a>.
        „Pod dohledem lékaře“ označuje výrobky, které výrobce uvádí jako potravinu pro zvláštní lékařské účely.
      </p>
      <p class="muted note">
        Údaje přebíráme ze složení na oficiálních webech výrobců (odkaz u názvu mléka); u každého mléka je datum ověření.
        Složení se může změnit – rozhodující je vždy obal výrobku, který máte doma. Připravujte podle návodu na balení.
      </p>
      <p class="muted note">
        Ceny jsou orientační: ceny uvedené v e-shopu Dr.Max 9. 11. 2026. V jiných obchodech
        a v čase se liší. Přepočet na 100 g prášku pomáhá srovnat různá balení; spotřeba prášku na jedno krmení se mezi mléky mírně liší.
      </p>
      <p class="muted note">
        Všechna počáteční a pokračovací mléka prodávaná v EU musí splňovat stejné požadavky na složení podle nařízení (EU) 2016/127.
        Kojení je podle WHO doporučeným způsobem výživy kojenců.
      </p>
      <p class="muted note">
        U některých šarží mlék probíhá stahování z trhu – ověřte DMT v přehledu{' '}
        <a href="/mleka/stazena-kojenecka-mleka/">Stažená kojenecká mléka</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .head { display: grid; gap: var(--space-2); padding-block: var(--space-6) var(--space-5); }
  .crumbs { font-size: var(--fs-small); }
  .crumbs a { color: var(--text-muted); }
  .brands { margin-bottom: var(--space-3); }
  .brands .eyebrow { display: block; }
  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: var(--space-4); }
  .jump .tag span { opacity: 0.6; margin-left: 0.25em; }
  .group { scroll-margin-top: 6rem; }
  .group + .group { margin-top: var(--space-6); }
  .group__head { margin-bottom: var(--space-3); max-width: 70ch; }
  .group__head h2 { margin: 0 0 0.4rem; }
  .group__head p { margin: 0; }
  .notes { display: grid; gap: var(--space-2); margin-top: var(--space-3); max-width: 70ch; }
  .note { font-size: var(--fs-small); }
</style>
