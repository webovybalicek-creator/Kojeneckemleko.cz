---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import { clusterMeta, type Cluster } from '../../data/clusters';

export function getStaticPaths() {
  return (Object.keys(clusterMeta) as Cluster[]).map((cluster) => ({ params: { cluster } }));
}

const cluster = Astro.params.cluster as Cluster;
const meta = clusterMeta[cluster];
const articles = (await getCollection('clanky', ({ data }) => data.cluster === cluster && (import.meta.env.DEV || !data.draft)))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Úvod', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: meta.title, item: new URL(`/${cluster}/`, Astro.site).toString() },
  ],
};
---
<Base title={meta.title} description={meta.description} jsonLd={[breadcrumbs]}>
  <section class="container">
    <header class:list={['hub-head', 'panel', `panel--${meta.tone}`]}>
      <nav class="crumbs" aria-label="Drobečková navigace"><a href="/">Úvod</a> <span aria-hidden="true">/</span> <span>{meta.title}</span></nav>
      <h1>{meta.title}</h1>
      <p class="lead">{meta.lead}</p>
      {cluster === 'mleka' && <a href="/mleka/srovnani/" class="btn">Srovnávací tabulka <Arrow /></a>}
    </header>
  </section>

  <section class="container section" aria-labelledby="clanky">
    <h2 id="clanky" class="eyebrow">Články</h2>
    {articles.length > 0 ? (
      <ul class="articles">
        {articles.map((a) => (
          <li>
            <a href={`/${cluster}/${a.id}/`} class="article-row">
              <span class="serif article-row__title">{a.data.title}</span>
              <span class="muted">{a.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="planned panel panel--cream">
        <p class="muted">Na článcích právě pracujeme. Připravujeme:</p>
        <ul>
          {meta.planned.map((p) => <li class="serif">{p}</li>)}
        </ul>
      </div>
    )}
  </section>
</Base>

<style>
  .hub-head { display: grid; gap: var(--space-3); justify-items: start; margin-top: var(--space-4); padding-block: var(--space-6); }
  .hub-head h1 { font-size: var(--fs-display); line-height: 1.05; }
  .crumbs { font-size: var(--fs-small); color: var(--text-muted); }
  .crumbs a { color: var(--text-muted); }

  .articles { list-style: none; padding: 0; margin-top: var(--space-3); border-top: 1px solid var(--line); }
  .article-row {
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);
    padding-block: var(--space-4); border-bottom: 1px solid var(--line);
    text-decoration: none; color: var(--text);
  }
  .article-row__title { font-size: var(--fs-h3); color: var(--ink); line-height: 1.3; }
  @media (hover: hover) and (pointer: fine) {
    .article-row:hover .article-row__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  }

  .planned { margin-top: var(--space-3); border: 1px solid var(--line); }
  .planned ul { margin-top: var(--space-2); padding-left: 1.25rem; display: grid; gap: var(--space-1); }
  .planned li { font-size: var(--fs-h3); color: var(--ink); line-height: 1.35; }

  @media (max-width: 760px) { .article-row { grid-template-columns: 1fr; gap: var(--space-1); } }
</style>
