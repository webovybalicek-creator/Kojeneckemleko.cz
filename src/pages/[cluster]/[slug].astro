---
import { getCollection } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { articlePath } from '../../i18n/ui';

export async function getStaticPaths() {
  const articles = await getCollection('clanky', ({ data }) => import.meta.env.DEV || !data.draft);
  const sk = await getCollection('skClanky', ({ data }) => import.meta.env.DEV || !data.draft);
  const byDate = [...articles].sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
  return articles.map((entry) => {
    // Související: jen ze stejného klastru (fotky a kresby se nemíchají)
    const related = byDate.filter((a) => a.id !== entry.id && a.data.cluster === entry.data.cluster).slice(0, 3);
    const skEntry = sk.find((s) => s.data.cs === entry.id);
    const alternates = skEntry
      ? { cs: articlePath('cs', entry.data.cluster, entry.id), sk: articlePath('sk', skEntry.data.cluster, skEntry.id) }
      : undefined;
    return { params: { cluster: entry.data.cluster, slug: entry.id }, props: { entry, related, alternates } };
  });
}

const { entry, related, alternates } = Astro.props;
---
<Article entry={entry} related={related} lang="cs" alternates={alternates} />
