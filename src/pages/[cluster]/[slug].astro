---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SourceList from '../../components/SourceList.astro';
import { clusterMeta } from '../../data/clusters';
import { annotate } from '../../data/terms.mjs';
import ArticleCards from '../../components/ArticleCards.astro';
import ArticleCover from '../../components/ArticleCover.astro';

export async function getStaticPaths() {
  const articles = await getCollection('clanky', ({ data }) => import.meta.env.DEV || !data.draft);
  const byDate = [...articles].sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
  return articles.map((entry) => {
    // Související: jen ze stejného klastru (fotky a kresby se nemíchají)
    const related = byDate.filter((a) => a.id !== entry.id && a.data.cluster === entry.data.cluster).slice(0, 3);
    return { params: { cluster: entry.data.cluster, slug: entry.id }, props: { entry, related } };
  });
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const meta = clusterMeta[data.cluster];
const url = new URL(Astro.url.pathname, Astro.site).toString();
const dateFmt = new Intl.DateTimeFormat('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' });

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.published.toISOString(),
  dateModified: data.updated.toISOString(),
  author: data.author.startsWith('Redakce')
    ? { '@type': 'Organization', name: data.author, url: Astro.site?.toString() }
    : { '@type': 'Person', name: data.author },
  publisher: { '@id': new URL('/#organizace', Astro.site).toString() },
  inLanguage: 'cs-CZ',
  mainEntityOfPage: url,
  image: [new URL(`/images/og/${entry.id}.png`, Astro.site).toString(), ...(data.cover?.photo ? [new URL(data.cover.photo, Astro.site).toString()] : [])],
  citation: data.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url, publisher: s.publisher })),
};
const faqLd = data.faq.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }]
  : [];
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Úvod', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: meta.title, item: new URL(`/${data.cluster}/`, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: data.title, item: url },
  ],
};
---
<Base title={data.title} description={data.description} ogType="article" ogImage={`/images/og/${entry.id}.png`} jsonLd={[articleLd, breadcrumbs, ...faqLd]} noindex={data.draft}>
  <article class="container article">
    <header class="article__head">
      <nav class="crumbs" aria-label="Drobečková navigace">
        <a href="/">Úvod</a> <span aria-hidden="true">/</span> <a href={`/${data.cluster}/`}>{meta.title}</a>
      </nav>
      <h1>{data.title}</h1>
      <p class="lead" set:html={annotate(data.description)} />
      <p class="byline muted">
        {data.author} · aktualizováno <time datetime={data.updated.toISOString()}>{dateFmt.format(data.updated)}</time>
        · <a href="/jak-tvorime-obsah/">jak tvoříme obsah</a>
      </p>
      {data.cover?.photo ? (
        <figure class="article__cover article__cover--photo">
          <img src={data.cover.photo} alt={data.cover.alt} width="1200" height="750" loading="eager" fetchpriority="high" decoding="async" />
        </figure>
      ) : data.cover ? (
        <figure class:list={['article__cover', `panel--${data.cover.tone}`]} aria-hidden="true">
          <ArticleCover motif={data.cover.motif} class="article__illu" />
        </figure>
      ) : null}
    </header>

    <div class="prose">
      <Content />
    </div>

    {data.faq.length > 0 && (
      <section class="faq" aria-labelledby="caste-otazky">
        <h2 id="caste-otazky">Časté otázky</h2>
        {data.faq.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>
              {f.a}
              {f.cite.length > 0 && (
                <sup class="cite">{f.cite.map((n, k) => <>{k > 0 && ','}<a href={`#zdroj-${n}`} aria-label={`Zdroj ${n}`}>{n}</a></>)}</sup>
              )}
            </p>
          </details>
        ))}
      </section>
    )}

    <SourceList sources={data.sources} updated={data.updated} />

    <p class="disclaimer muted">
      Článek má informativní charakter a nenahrazuje konzultaci s pediatrem. Máte-li o zdraví dítěte obavy, obraťte se na lékaře.
    </p>
  </article>

  {related.length > 0 && (
    <section class="container related" aria-labelledby="souvisejici">
      <h2 id="souvisejici">Související články</h2>
      <ArticleCards articles={related} />
    </section>
  )}
</Base>

<style>
  .article { max-width: calc(46rem + 2 * var(--gutter)); padding-top: var(--space-5); }
  .article__cover { margin: var(--space-2) 0 0; border-radius: var(--radius-card); overflow: hidden; aspect-ratio: 16 / 9; display: grid; place-items: center; }
  .article__cover--photo { background: var(--color-keylime-wash); }
  .article__cover--photo img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(0.9); }
  .article__cover :global(.article__illu) { width: min(52%, 22rem); height: auto; }
  .article__head { display: grid; gap: var(--space-3); margin-bottom: var(--space-5); padding-bottom: var(--space-4); border-bottom: 1px solid var(--line); }
  .crumbs, .byline { font-size: var(--fs-small); }
  .crumbs a { color: var(--text-muted); }

  .prose { margin-bottom: var(--space-5); }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(h2) { margin-top: 1.8em; }
  .prose :global(h3) { margin-top: 1.5em; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.25rem; }
  .prose :global(li + li) { margin-top: 0.35em; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: var(--fs-small); font-variant-numeric: tabular-nums; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 0.75rem; border-bottom: 1px solid var(--line); }
  @media (max-width: 640px) {
    .prose :global(table) { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .prose :global(th), .prose :global(td) { padding: 0.6rem 0.5rem; min-width: 7.5rem; }
    .prose :global(th:first-child), .prose :global(td:first-child) { min-width: 5.5rem; }
  }
  .prose :global(blockquote) { border-left: 2px solid var(--color-sage-mist); padding-left: var(--space-3); color: var(--text-muted); }

  .disclaimer { font-size: var(--fs-small); margin-top: var(--space-4); }
  .faq { margin-bottom: var(--space-5); }
  .faq h2 { margin-bottom: var(--space-3); }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq__item:first-of-type { border-top: 1px solid var(--line); }
  .faq__item summary {
    cursor: pointer; list-style: none; padding: var(--space-2) 2rem var(--space-2) 0; position: relative;
    font-weight: 600; color: var(--ink);
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after {
    content: ''; position: absolute; right: 0.25rem; top: 50%; width: 0.55rem; height: 0.55rem;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: translateY(-70%) rotate(45deg); transition: transform var(--dur-base) var(--ease-out);
  }
  .faq__item[open] summary::after { transform: translateY(-30%) rotate(-135deg); }
  .faq__item p { padding: 0 0 var(--space-3); color: var(--text); }
  @media (prefers-reduced-motion: reduce) { .faq__item summary::after { transition: none; } }
  .related { padding-top: var(--space-6); padding-bottom: var(--space-6); border-top: 1px solid var(--line); margin-top: var(--space-6); }
  .related h2 { margin-bottom: var(--space-4); }
</style>
