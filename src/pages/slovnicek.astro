---
import Base from '../layouts/Base.astro';
import SourceList from '../components/SourceList.astro';
import Arrow from '../components/Arrow.astro';
import { glossary, glossaryGroups, glossarySources, type GlossaryGroup } from '../data/slovnicek';

const groups = Object.keys(glossaryGroups) as GlossaryGroup[];
const url = new URL('/slovnicek/', Astro.site).toString();

// [n] → odkaz na zdroj
const withRefs = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\[(\d+)\]/g, '<a class="ref" href="#zdroj-$1">[$1]</a>');

const definedTermSet = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Slovníček pojmů kojenecké výživy',
  url,
  inLanguage: 'cs-CZ',
  hasDefinedTerm: glossary.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.term,
    alternateName: t.aka,
    description: t.short,
    url: `${url}#${t.id}`,
  })),
};
---
<Base
  title="Slovníček pojmů"
  description="Co znamená HA, AR, comfort, pokračovací nebo batolecí mléko, ABKM či cereulid. Srozumitelné vysvětlení pojmů kojenecké výživy podle NHS, WHO a Cochrane."
  jsonLd={[definedTermSet]}
>
  <div class="container page">
    <header class="stack head">
      <nav class="crumbs" aria-label="Drobečková navigace"><a href="/">Úvod</a> <span aria-hidden="true">/</span> <span>Slovníček</span></nav>
      <p class="eyebrow">Slovníček</p>
      <h1>Co znamená HA, AR nebo comfort?</h1>
      <p class="lead">Pojmy z obalů kojeneckých mlék a z našich článků, vysvětlené srozumitelně a s odkazem na zdroj.</p>
      <nav class="jump" aria-label="Rejstřík pojmů">
        {glossary.map((t) => <a href={`#${t.id}`} class="tag tag--sm tag--soft">{t.term}</a>)}
      </nav>
    </header>

    {groups.map((g) => (
      <section class="group" aria-labelledby={`g-${g}`}>
        <h2 id={`g-${g}`}>{glossaryGroups[g]}</h2>
        <dl class="terms">
          {glossary.filter((t) => t.group === g).map((t) => (
            <div class="term-card panel" id={t.id}>
              <dt>
                <span class="heading-sm">{t.term}</span>
                {t.aka && <span class="aka muted">{t.aka}</span>}
              </dt>
              <dd>
                {t.body.map((p) => <p set:html={withRefs(p)} />)}
                {t.note && <p class="note">{t.note}</p>}
                {t.link && <a href={t.link.href} class="more">{t.link.label} <Arrow /></a>}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}

    <SourceList sources={glossarySources} updated={new Date('2026-11-07')} />
    <p class="muted small disclaimer">Slovníček má informativní charakter. O výběru speciálního mléka vždy rozhoduje pediatr.</p>
  </div>
</Base>

<style>
  .page { max-width: calc(52rem + 2 * var(--gutter)); padding-top: var(--space-6); }
  .head { margin-bottom: var(--space-5); }
  .crumbs { font-size: var(--fs-small); color: var(--text-muted); }
  .crumbs a { color: var(--text-muted); }
  .jump { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--space-2); }
  .jump a { text-decoration: none; transition: background-color var(--dur-fast) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .jump a:hover { background: var(--color-sage-mist); } }

  .group { margin-top: var(--space-6); }
  .group h2 { margin-bottom: var(--space-3); }
  .terms { display: grid; gap: var(--space-2); }
  .term-card {
    background: var(--color-keylime-wash); padding: var(--space-4);
    display: grid; grid-template-columns: 14rem 1fr; gap: var(--space-4);
    scroll-margin-top: 6rem;
    transition: background-color var(--dur-base) var(--ease-out);
  }
  .term-card:target { background: var(--color-mint-veil); }
  dt { display: grid; gap: 4px; align-content: start; }
  .aka { font-size: var(--fs-small); }
  dd { margin: 0; display: grid; gap: var(--space-1); }
  dd p { font-size: var(--fs-body); }
  .note { font-size: var(--fs-small); color: var(--ink); font-weight: 500; }
  .more { display: inline-flex; align-items: center; gap: 0.35em; font-size: var(--fs-small); text-decoration: none; margin-top: 4px; }
  .more :global(svg) { width: 1em; transition: transform var(--dur-base) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .more:hover :global(svg) { transform: translateX(3px); } .more:hover { text-decoration: underline; } }
  dd :global(.ref) { font-size: 0.8em; text-decoration: none; }
  .disclaimer { margin-top: var(--space-4); }
  .small { font-size: var(--fs-small); }
  @media (max-width: 760px) { .term-card { grid-template-columns: 1fr; gap: var(--space-2); } }
</style>
